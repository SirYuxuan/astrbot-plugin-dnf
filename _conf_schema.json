{
  "platform": {
    "description": "平台配置",
    "hint": "用于主动推送消息的平台适配。",
    "type": "object",
    "items": {
      "name": {
        "description": "平台名称",
        "hint": "用于主动推送的 AstrBot 平台名称。",
        "type": "string",
        "default": "aiocqhttp"
      }
    }
  },
  "gold": {
    "description": "金币监控",
    "hint": "DNF 金币比例查询和波动推送配置。",
    "type": "object",
    "items": {
      "monitor_enabled": {
        "description": "启用监控",
        "hint": "是否定时检测金币比例变化。",
        "type": "bool",
        "default": true
      },
      "notify_group_id": {
        "description": "推送群号",
        "hint": "金币比例波动通知发送到这个群。",
        "type": "int",
        "default": 101344113
      },
      "interval_seconds": {
        "description": "检测间隔",
        "hint": "金币比例检测间隔，单位秒。",
        "type": "int",
        "default": 60
      },
      "change_threshold": {
        "description": "波动阈值",
        "hint": "金币均价变化达到多少万金币时推送。",
        "type": "float",
        "default": 2.0
      }
    }
  },
  "oil": {
    "description": "油价监控",
    "hint": "油价查询和每日变动推送配置。",
    "type": "object",
    "items": {
      "monitor_enabled": {
        "description": "启用监控",
        "hint": "是否每天检查油价变化。",
        "type": "bool",
        "default": true
      },
      "notify_group_id": {
        "description": "推送群号",
        "hint": "油价变动通知发送到这个群。",
        "type": "int",
        "default": 101344113
      },
      "monitor_areas": {
        "description": "监控地区",
        "hint": "油价监控地区列表，例如 [\"河南\", \"北京\"]。",
        "type": "list",
        "default": [
          "河南"
        ]
      },
      "check_hour": {
        "description": "检查小时",
        "hint": "每日检查小时，范围 0-23。",
        "type": "int",
        "default": 8
      },
      "startup_notice_enabled": {
        "description": "启动通知",
        "hint": "插件启动时是否发送一次油价通知。",
        "type": "bool",
        "default": true
      }
    }
  },
  "egg": {
    "description": "蛋价监控",
    "hint": "蛋价查询和每日推送配置。",
    "type": "object",
    "items": {
      "monitor_enabled": {
        "description": "启用推送",
        "hint": "是否启用蛋价每日推送。",
        "type": "bool",
        "default": true
      },
      "notify_group_id": {
        "description": "推送群号",
        "hint": "蛋价通知发送到这个群。",
        "type": "int",
        "default": 527189909
      },
      "monitor_area": {
        "description": "推送地区",
        "hint": "蛋价每日推送地区。",
        "type": "string",
        "default": "平舆"
      },
      "interval_seconds": {
        "description": "检测间隔",
        "hint": "蛋价检测间隔，单位秒。",
        "type": "int",
        "default": 3600
      },
      "daily_limit": {
        "description": "展示条数",
        "hint": "蛋价查询和推送最多展示条数。",
        "type": "int",
        "default": 10
      }
    }
  }
}
