{
  "platform": {
    "description": "平台配置",
    "hint": "用于主动推送消息的平台适配。",
    "type": "object",
    "items": {
      "name": {
        "description": "平台名称",
        "hint": "用于主动推送的 AstrBot 平台名称。",
        "type": "string",
        "default": "aiocqhttp"
      }
    }
  },
  "gold": {
    "description": "金币监控",
    "hint": "DNF 金币比例查询和波动推送配置。",
    "type": "object",
    "items": {
      "monitor_enabled": {
        "description": "启用监控",
        "hint": "是否定时检测金币比例变化。",
        "type": "bool",
        "default": true
      },
      "notify_group_id": {
        "description": "推送群号",
        "hint": "金币比例波动通知发送到这个群。",
        "type": "int",
        "default": 101344113
      },
      "interval_seconds": {
        "description": "检测间隔",
        "hint": "金币比例检测间隔，单位秒。",
        "type": "int",
        "default": 60
      },
      "change_threshold": {
        "description": "波动阈值",
        "hint": "金币均价变化达到多少万金币时推送。",
        "type": "float",
        "default": 2.0
      }
    }
  },
  "oil": {
    "description": "油价监控",
    "hint": "油价查询和每日变动推送配置。",
    "type": "object",
    "items": {
      "monitor_enabled": {
        "description": "启用监控",
        "hint": "是否每天检查油价变化。",
        "type": "bool",
        "default": true
      },
      "notify_group_id": {
        "description": "推送群号",
        "hint": "油价变动通知发送到这个群。",
        "type": "int",
        "default": 101344113
      },
      "monitor_areas": {
        "description": "监控地区",
        "hint": "油价监控地区列表，例如 [\"河南\", \"北京\"]。",
        "type": "list",
        "default": [
          "河南"
        ]
      },
      "check_hour": {
        "description": "检查小时",
        "hint": "每日检查小时，范围 0-23。",
        "type": "int",
        "default": 8
      },
      "startup_notice_enabled": {
        "description": "启动通知",
        "hint": "插件启动时是否发送一次油价通知。",
        "type": "bool",
        "default": true
      }
    }
  },
  "egg": {
    "description": "蛋价监控",
    "hint": "蛋价查询和每日推送配置。",
    "type": "object",
    "items": {
      "monitor_enabled": {
        "description": "启用推送",
        "hint": "是否启用蛋价每日推送。",
        "type": "bool",
        "default": true
      },
      "notify_group_id": {
        "description": "推送群号",
        "hint": "蛋价通知发送到这个群。",
        "type": "int",
        "default": 527189909
      },
      "monitor_area": {
        "description": "推送地区",
        "hint": "蛋价每日推送地区。",
        "type": "string",
        "default": "平舆"
      },
      "interval_seconds": {
        "description": "检测间隔",
        "hint": "蛋价检测间隔，单位秒。",
        "type": "int",
        "default": 3600
      },
      "daily_limit": {
        "description": "展示条数",
        "hint": "蛋价查询和推送最多展示条数。",
        "type": "int",
        "default": 10
      }
    }
  },
  "eve": {
    "description": "EVE 欧服吉他查价",
    "hint": "名称库、CCP ESI 请求和 Redis 共享缓存配置。",
    "type": "object",
    "items": {
      "search_result_limit": {
        "description": "候选结果数量",
        "hint": "名称模糊查询最多显示多少个候选，范围 1-20。",
        "type": "int",
        "default": 5
      },
      "request_timeout_seconds": {
        "description": "行情请求超时",
        "hint": "CCP ESI 单次请求超时秒数。",
        "type": "int",
        "default": 30
      },
      "sde_timeout_seconds": {
        "description": "名称库更新超时",
        "hint": "下载 CCP SDE 压缩包的超时秒数。",
        "type": "int",
        "default": 300
      },
      "cache_seconds": {
        "description": "行情缓存时间",
        "hint": "ESI 未返回有效 Expires 时使用的缓存秒数。",
        "type": "int",
        "default": 300
      },
      "cache_stale_seconds": {
        "description": "Redis 保留时间",
        "hint": "行情分页数据在 Redis 中的最长保留秒数。",
        "type": "int",
        "default": 3600
      },
      "redis_url": {
        "description": "Redis 地址",
        "hint": "例如 redis://localhost:6379/0；留空时仅使用进程内缓存。",
        "type": "string",
        "default": "redis://localhost:6379/0",
        "obvious_hint": true
      },
      "redis_prefix": {
        "description": "Redis Key 前缀",
        "hint": "多个部署共用 Redis 时用于隔离缓存。",
        "type": "string",
        "default": "yuxuandnf:eve"
      },
      "user_agent": {
        "description": "ESI User-Agent",
        "hint": "CCP 建议包含应用名、版本和项目地址。",
        "type": "string",
        "default": "astrbot-plugin-dnf/1.6 (+https://github.com/SirYuxuan/astrbot-plugin-dnf)"
      }
    }
  }
}
